{
  "name": "booking-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:migrate:remote && npm --prefix ../FRONTEND run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply booking --local",
    "db:migrate:remote": "wrangler d1 migrations apply booking --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
