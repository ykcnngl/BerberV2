# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun. .env git'e eklenmez, bu şablon eklenir.

# Veritabanı
DB_URL=jdbc:postgresql://localhost:5433/booking_db
DB_USERNAME=postgres
DB_PASSWORD=

# Yönetici paneli şifresi (en az 12 karakter)
ADMIN_PASSWORD=

# SMS: "netgsm" = gerçek SMS, "log" = kodlar sadece backend konsoluna yazılır (geliştirme)
SMS_PROVIDER=log
# Netgsm panelinden: abonelik numarası (850...), API şifresi ve onaylı gönderici başlığı
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# İşletme adı ve telefonu (müşteriye giden SMS'lerde kullanılır)
BUSINESS_NAME=
BUSINESS_PHONE=

# Canlıda sitenin adresi (virgülle birden fazla), örn. https://www.ornek.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Galeri fotoğraflarının klasörü (boşsa booking/uploads kullanılır)
UPLOAD_DIR=
